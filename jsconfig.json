{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "bin/**/*.js",
    "bin/**/*.mjs",
    "src/**/*.d.ts"
  ]
}
