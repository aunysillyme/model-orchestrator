{
  "name": "model-orchestrator",
  "version": "0.1.14",
  "description": "Routing instructions and a CLI runner for your AI tools. One installer generates a setup for what you have, from one chat app to several agent CLIs or a VM. Routes by role, complexity and risk; pins and logs each lane's model and effort. On Claude Code it delegates to subagents by default, with hooks that inject the routing table every turn.",
  "type": "module",
  "bin": {
    "model-orchestrator": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "scripts"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "dry-run": "node bin/cli.js --yes --level 2 --ais claude-code,codex,grok --dir ./tmp-dry-run --dry",
    "gen:catalog": "node scripts/gen-catalog.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aunysillyme/model-orchestrator.git"
  },
  "homepage": "https://github.com/aunysillyme/model-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/aunysillyme/model-orchestrator/issues"
  },
  "keywords": [
    "ai",
    "orchestrator",
    "model-router",
    "claude-code",
    "codex",
    "antigravity",
    "grok",
    "ollama",
    "litellm",
    "multi-agent",
    "cli",
    "llm",
    "agents",
    "subagents",
    "qwen",
    "mcp",
    "reasoning-effort",
    "model-routing",
    "code-review",
    "ai-agents",
    "hooks",
    "claude-code-hooks",
    "delegation"
  ],
  "author": "aunysillyme (https://github.com/aunysillyme)",
  "license": "MIT"
}
