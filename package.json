{
  "name": "model-orchestrator",
  "version": "0.1.18",
  "description": "Model orchestrator for AI coding agents and LLMs: Claude Code, Codex, Gemini, Grok, Qwen, Ollama. Routing rules tell your agent which model, subagent or CLI to use for each task, so small work goes to cheap tiers and fewer tokens go to frontier models. One installer, plus a CLI runner that logs every route.",
  "type": "module",
  "bin": {
    "model-orchestrator": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "scripts",
    "llms.txt",
    "AGENTS.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "dry-run": "node bin/cli.js --yes --level 2 --ais claude-code,codex,grok --dir ./tmp-dry-run --dry",
    "gen:catalog": "node scripts/gen-catalog.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aunysillyme/model-orchestrator.git"
  },
  "homepage": "https://github.com/aunysillyme/model-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/aunysillyme/model-orchestrator/issues"
  },
